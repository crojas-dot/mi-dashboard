'use client'

import { useMemo, useState } from 'react'
import Link from 'next/link'
import { CSpinner, CTable, CTableBody, CTableDataCell, CTableHead, CTableHeaderCell, CTableRow } from '@coreui/react'
import ErrorState from '@/components/ui/ErrorState'
import Badge from '@/components/ui/Badge'
import Card from '@/components/ui/Card'
import DashboardKpi, { type KpiTone } from './DashboardKpi'
import CChart from './Chart'
import { CheckCircle, FileText, History, Inbox, ShieldAlert } from '@/components/ui/icons'
import { useActividadReciente, type DashboardData } from '@/lib/queries/useDashboard'
import styles from '@/app/dashboard.module.css'

interface GeneralTabProps {
  data?: DashboardData
  isPending: boolean
  isFetching: boolean
  error: Error | null
  refetch: () => void
}

const estadoBadge: Record<string, string> = {
  Abierta: 'red', Alta: 'red', 'En Proceso': 'amber', Planificada: 'blue',
  Abierto: 'red', Pendiente: 'amber', Cerrada: 'green', Cerrado: 'green',
  Publicado: 'green', Borrador: 'gray', Activo: 'green', Inactivo: 'gray',
}

const kpiConf: { icon: React.ReactNode; tone: KpiTone; context: string }[] = [
  { icon: <Inbox size={20} />, tone: 'red', context: 'Expedientes por atender' },
  { icon: <CheckCircle size={20} />, tone: 'amber', context: 'Acciones de mejora activas' },
  { icon: <FileText size={20} />, tone: 'blue', context: 'Documentos sin publicar' },
  { icon: <ShieldAlert size={20} />, tone: 'green', context: 'Identificados · en seguimiento' },
]

export default function GeneralTab({ data, isPending, isFetching, error, refetch }: GeneralTabProps) {
  const actividad = useActividadReciente()
  const [ahora] = useState(() => Date.now())

  const tareas = useMemo(() => data?.tareas ?? [], [data?.tareas])
  const indicadores = useMemo(() => data?.indicadores ?? [], [data?.indicadores])

  const vencimientos = useMemo(() => {
    const b = { '≤ 7 días': 0, '8–15 días': 0, '16–30 días': 0, 'Más de 30 días': 0 }
    for (const t of tareas) {
      if (!t.vence) continue
      const dias = Math.floor((new Date(t.vence).getTime() - ahora) / 86400000)
      if (dias <= 7) b['≤ 7 días'] += 1
      else if (dias <= 15) b['8–15 días'] += 1
      else if (dias <= 30) b['16–30 días'] += 1
      else b['Más de 30 días'] += 1
    }
    return b
  }, [tareas, ahora])

  const venceData = useMemo(() => ({
    labels: Object.keys(vencimientos),
    datasets: [{
      label: 'Expedientes',
      data: Object.values(vencimientos),
      backgroundColor: ['#e55353', '#f9b115', '#3399ff', '#6b7785'],
      borderRadius: 3,
      maxBarThickness: 16,
    }],
  }), [vencimientos])

  const venceOptions = useMemo(() => ({
    indexAxis: 'y' as const,
    maintainAspectRatio: false,
    animation: false,
    plugins: { legend: { display: false }, tooltip: { titleFont: { size: 14 }, bodyFont: { size: 13 } } },
    scales: {
      x: { beginAtZero: true, ticks: { precision: 0, color: '#626975', font: { size: 13 } }, grid: { color: '#e7e9ee' } },
      y: { grid: { display: false }, ticks: { color: '#626975', font: { size: 13 } } },
    },
  }), [])

  const quejas = tareas.filter((t) => t.entidad === 'Quejas').length
  const acciones = tareas.filter((t) => t.entidad === 'SACP').length

  const donutData = useMemo(() => ({
    labels: tareas.length ? ['Quejas', 'SACP'] : ['Sin pendientes'],
    datasets: [{ data: tareas.length ? [quejas, acciones] : [1], backgroundColor: tareas.length ? ['#4257be', '#3399ff'] : ['#e7e9ee'], borderWidth: 0 }],
  }), [acciones, quejas, tareas.length])

  const donutOptions = useMemo(() => ({
    maintainAspectRatio: false,
    animation: false,
    cutout: '72%',
    plugins: { legend: { display: false }, tooltip: { enabled: tareas.length > 0 } },
  }), [tareas.length])

  if (error) {
    return <ErrorState error={error} title="No se pudo cargar el panel general" onRetry={() => void refetch()} retrying={isFetching} />
  }
  if (isPending || !data) {
    return <div role="status" className={styles.empty}><CSpinner color="primary" /></div>
  }

  const hayVence = tareas.some((t) => t.vence)

  return (
    <div role="tabpanel">
      <div className={styles.kpiGrid}>
        {indicadores.map((ind, index) => (
          <DashboardKpi
            key={ind.url}
            label={ind.label}
            value={ind.valor}
            context={kpiConf[index]?.context}
            icon={kpiConf[index]?.icon}
            tone={kpiConf[index]?.tone ?? 'purple'}
            href={ind.url}
          />
        ))}
      </div>

      <div className={styles.chartsRow}>
        <Card title="Vencimientos próximos" action={<Link href="/quejas" className="fw-medium text-decoration-none text-primary" style={{ fontSize: 14 }}>Ver quejas</Link>}>
          {hayVence ? (
            <div className={styles.chartMedium}>
              <CChart
                type="bar"
                wrapper={false}
                customTooltips={false}
                role="img"
                aria-label={Object.entries(vencimientos).map(([k, v]) => `${k}: ${v}`).join(', ')}
                data={venceData}
                options={venceOptions as never}
              />
            </div>
          ) : (
            <p className="text-body-secondary mb-0">No hay expedientes con vencimiento definido.</p>
          )}
          <div className={styles.legend} style={{ marginTop: 12 }}>
            {Object.entries(vencimientos).map(([k, v]) => (
              <span key={k}><i /><span>{k} <strong>{v}</strong></span></span>
            ))}
          </div>
        </Card>
        <Card title="Distribución de pendientes">
          <div className={styles.donut}>
            <CChart
              type="doughnut"
              wrapper={false}
              customTooltips={false}
              role="img"
              aria-label={`${quejas} quejas y ${acciones} acciones SACP`}
              data={donutData}
              options={donutOptions as never}
            />
            <div className={styles.donutTotal}><strong>{tareas.length}</strong><span>Pendientes</span></div>
          </div>
          <div className={styles.legend}><span><i style={{ background: '#4257be' }} />Quejas <strong>{quejas}</strong></span><span><i style={{ background: '#3399ff' }} />SACP <strong>{acciones}</strong></span></div>
        </Card>
      </div>

      <div className={`${styles.lowerGrid} mb-4`}>
        <Card title="Expedientes que requieren atención" bodyClassName="p-0">
          <div className={styles.tableWrap}>
            <CTable align="middle" hover className="">
              <CTableHead><CTableRow>{['Expediente', 'Tipo', 'Estado', 'Vence'].map((label) => <CTableHeaderCell key={label} scope="col">{label}</CTableHeaderCell>)}</CTableRow></CTableHead>
              <CTableBody>
                {tareas.length === 0 ? (
                  <CTableRow><CTableDataCell colSpan={4}><div className={styles.empty}>No hay expedientes pendientes</div></CTableDataCell></CTableRow>
                ) : tareas.map((t) => (
                  <CTableRow key={`${t.entidad}-${t.id}`}>
                    <CTableDataCell><strong className="fw-medium">{t.titulo}</strong><div className="small text-body-secondary">{t.entidad}</div></CTableDataCell>
                    <CTableDataCell>{t.tipo}</CTableDataCell>
                    <CTableDataCell><Badge variant={estadoBadge[t.estado] ?? 'gray'}>{t.estado}</Badge></CTableDataCell>
                    <CTableDataCell className="text-nowrap">{t.vence ? new Date(t.vence).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }) : 'Sin fecha'}</CTableDataCell>
                  </CTableRow>
                ))}
              </CTableBody>
            </CTable>
          </div>
        </Card>
        <div className={styles.sideColumn}>
          <Card title="Actividad reciente" action={<History size={18} />}>
            {actividad.isPending ? <div className="d-flex justify-content-center py-2" role="status"><CSpinner size="sm" /></div>
              : actividad.error ? <ErrorState error={actividad.error} title="No se pudo cargar la actividad" onRetry={() => void actividad.refetch()} retrying={actividad.isFetching} />
                : !actividad.data?.length ? <p className="text-body-secondary mb-0">Sin actividad registrada.</p>
                  : <ol className={styles.timeline}>{actividad.data.map((item) => <li key={item.id}><p>{item.descripcion}</p><time dateTime={item.created_at}>{new Date(item.created_at).toLocaleString('es-CR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</time></li>)}</ol>}
          </Card>
        </div>
      </div>
    </div>
  )
}
'use client'

import { useMemo, useState } from 'react'
import Link from 'next/link'
import { CSpinner, CCard, CCardHeader, CCardBody } from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilInbox, cilCheckCircle, cilFile, cilShieldAlt } from '@coreui/icons'
import ErrorState from '@/components/ui/ErrorState'
import Badge from '@/components/ui/Badge'
import StatCard from '@/components/StatCard'
import CChart from './Chart'
import { History } from '@/components/ui/icons'
import { useActividadReciente, type DashboardData } from '@/lib/queries/useDashboard'
import styles from '@/app/dashboard.module.css'

interface GeneralTabProps {
  data?: DashboardData
  isPending: boolean
  isFetching: boolean
  error: Error | null
  refetch: () => void
}

const estadoBadge: Record<string, string> = {
  Abierta: 'red', Alta: 'red', 'En Proceso': 'amber', Planificada: 'blue',
  Abierto: 'red', Pendiente: 'amber', Cerrada: 'green', Cerrado: 'green',
  Publicado: 'green', Borrador: 'gray', Activo: 'green', Inactivo: 'gray',
}

const colorVencidos = ['#2eb85c', '#f9b115', '#3399ff', '#6b7785']

export default function GeneralTab({ data, isPending, isFetching, error, refetch }: GeneralTabProps) {
  const actividad = useActividadReciente()
  const [ahora] = useState(() => Date.now())

  const tareas = useMemo(() => data?.tareas ?? [], [data?.tareas])
  const indicadores = useMemo(() => data?.indicadores ?? [], [data?.indicadores])

  const kpis = useMemo(() => [
    { label: 'Quejas Abiertas', valor: indicadores[0]?.valor ?? 0, color: 'red' as const, icon: <CIcon icon={cilInbox} height={28} />, footer: 'Expedientes por atender' },
    { label: 'SACP en Proceso', valor: indicadores[1]?.valor ?? 0, color: 'amber' as const, icon: <CIcon icon={cilCheckCircle} height={28} />, footer: 'Acciones de mejora activas' },
    { label: 'Docs. en Borrador', valor: indicadores[2]?.valor ?? 0, color: 'blue' as const, icon: <CIcon icon={cilFile} height={28} />, footer: 'Documentos sin publicar' },
    { label: 'Riesgos Activos', valor: indicadores[3]?.valor ?? 0, color: 'green' as const, icon: <CIcon icon={cilShieldAlt} height={28} />, footer: 'Identificados · en seguimiento' },
  ], [indicadores])

  const vencimientos = useMemo(() => {
    const b = { '≤ 7 días': 0, '8–15 días': 0, '16–30 días': 0, 'Más de 30 días': 0 }
    for (const t of tareas) {
      if (!t.vence) continue
      const dias = Math.floor((new Date(t.vence).getTime() - ahora) / 86400000)
      if (dias <= 7) b['≤ 7 días'] += 1
      else if (dias <= 15) b['8–15 días'] += 1
      else if (dias <= 30) b['16–30 días'] += 1
      else b['Más de 30 días'] += 1
    }
    return b
  }, [tareas, ahora])

  const venceData = useMemo(() => ({
    labels: Object.keys(vencimientos),
    datasets: [{
      label: 'Expedientes',
      data: Object.values(vencimientos),
      backgroundColor: colorVencidos,
      borderRadius: 3,
      maxBarThickness: 16,
    }],
  }), [vencimientos])

  const venceOptions = useMemo(() => ({
    indexAxis: 'y' as const,
    maintainAspectRatio: false,
    animation: false,
    plugins: { legend: { display: false }, tooltip: { titleFont: { size: 14 }, bodyFont: { size: 13 } } },
    scales: {
      x: { beginAtZero: true, ticks: { precision: 0, color: '#626975', font: { size: 13 } }, grid: { color: '#e7e9ee' } },
      y: { grid: { display: false }, ticks: { color: '#626975', font: { size: 13 } } },
    },
  }), [])

  const quejas = tareas.filter((t) => t.entidad === 'Quejas').length
  const acciones = tareas.filter((t) => t.entidad === 'SACP').length

  const donutData = useMemo(() => ({
    labels: tareas.length ? ['Quejas', 'SACP'] : ['Sin pendientes'],
    datasets: [{ data: tareas.length ? [quejas, acciones] : [1], backgroundColor: tareas.length ? ['#5856d6', '#3399ff'] : ['#e7e9ee'], borderWidth: 0 }],
  }), [acciones, quejas, tareas.length])

  const donutOptions = useMemo(() => ({
    maintainAspectRatio: false,
    animation: false,
    cutout: '72%',
    plugins: { legend: { display: false }, tooltip: { enabled: tareas.length > 0 } },
  }), [tareas.length])

  if (error) {
    return <ErrorState error={error} title="No se pudo cargar el panel general" onRetry={() => void refetch()} retrying={isFetching} />
  }
  if (isPending || !data) {
    return <div role="status" className={styles.empty}><CSpinner color="primary" /></div>
  }

  const hayVence = tareas.some((t) => t.vence)

  const chartCard = (title: string, action: React.ReactNode | undefined, children: React.ReactNode) => (
    <CCard className="h-100">
      <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 className="m-0 fs-5">{title}</h2>
        {action}
      </CCardHeader>
      <CCardBody>{children}</CCardBody>
    </CCard>
  )

  return (
    <div role="tabpanel">
      <div className={styles.kpiGrid}>
        {kpis.map((k) => (
          <StatCard key={k.label} title={k.label} value={k.valor} icon={k.icon} color={k.color} subtitle={k.footer} />
        ))}
      </div>

      <div className={styles.chartsRow}>
        {chartCard('Vencimientos próximos', <Link href="/quejas" className="fw-medium text-decoration-none text-primary" style={{ fontSize: 14 }}>Ver quejas</Link>,
          hayVence ? (
            <div className={styles.chartMedium}>
              <CChart
                type="bar"
                wrapper={false}
                customTooltips={false}
                role="img"
                aria-label={Object.entries(vencimientos).map(([k, v]) => `${k}: ${v}`).join(', ')}
                data={venceData}
                options={venceOptions as never}
              />
            </div>
          ) : (
            <p className="text-body-secondary mb-0">No hay expedientes con vencimiento definido.</p>
          )
        )}
        <div style={{ minWidth: 300 }} />
      </div>

      <div className={styles.chartsRow}>
        {chartCard('Vencimientos próximos 2', undefined, <></>)}
        <div style={{ minWidth: 300 }} />
      </div>

      <div className={styles.lowerGrid} style={{ display: 'none' }}>
        <p>xd</p>
      </div>
    </div>
  )
}
'use client'

import { useMemo, useState } from 'react'
import Link from 'next/link'
import {
  CSpinner,
  CRow,
  CCol,
  CCard,
  CCardHeader,
  CCardBody,
  CTable,
  CTableHead,
  CTableHeaderCell,
  CTableBody,
  CTableRow,
  CTableDataCell,
} from '@coreui/react'
import ErrorState from '@/components/ui/ErrorState'
import Badge from '@/components/ui/Badge'
import CChart from './Chart'
import { ChartEmpty, PanelMetric, opcionesBarras, opcionesDonut, opcionesLinea, uiColors } from './chartKit'
import { useSLAConfig, useQuejasEstadisticas, quejasEstadisticasKey } from '@/lib/queries/useQuejas'
import { useQuejasAnalisis, quejasAnalisisKey } from '@/lib/queries/useQuejasAnalisis'
import { useRealtimeSubscription } from '@/hooks/useRealtimeSubscription'
import { queryKeys } from '@/lib/queries/queryKeys'
import { estadoVariant } from '@/lib/constants/variants'
import styles from '@/app/dashboard.module.css'

const ORDEN_SITUACION = ['Recibidas', 'En gestión', 'Pendientes de revisión', 'Cerradas/Resueltas', 'No procede', 'Otros']

function macroSituacion(estado: string): string {
  switch (estado) {
    case 'Recibido': return 'Recibidas'
    case 'En Investigación': return 'En gestión'
    case 'Pendiente de Revisión GC': return 'Pendientes de revisión'
    case 'Resuelto':
    case 'Finalizado':
    case 'Cerrada': return 'Cerradas/Resueltas'
    case 'No Procede': return 'No procede'
    default: return 'Otros'
  }
}

export default function QuejasTab() {
  const estadisticas = useQuejasEstadisticas()
  const slaConfig = useSLAConfig('quejas')
  const { data: analisis, isPending, isFetching, error, refetch } = useQuejasAnalisis()
  const [ahora] = useState(() => Date.now())
  const c = uiColors()

  useRealtimeSubscription({
    table: 'quejas',
    invalidateKeys: [quejasEstadisticasKey, quejasAnalisisKey, [...queryKeys.dashboard]],
  })

  const slaMap = useMemo(() => {
    const m: Record<string, { dias_alerta: number; dias_vencimiento: number }> = {}
    for (const s of slaConfig.data ?? []) m[s.prioridad] = s
    return m
  }, [slaConfig.data])

  const slaPorPrioridad = useMemo(() => {
    const res: Record<string, { aTiempo: number; alerta: number; vencidas: number }> = {}
    for (const f of analisis?.activas ?? []) {
      if (!f.fecha_sla) continue
      const p = f.prioridad || 'Media'
      const cfg = slaMap[p] ?? { dias_alerta: 3, dias_vencimiento: 7 }
      const dias = Math.floor((ahora - new Date(f.fecha_sla).getTime()) / 86400000)
      const row = res[p] ?? (res[p] = { aTiempo: 0, alerta: 0, vencidas: 0 })
      if (dias <= cfg.dias_alerta) row.aTiempo += 1
      else if (dias <= cfg.dias_vencimiento) row.alerta += 1
      else row.vencidas += 1
    }
    return res
  }, [analisis?.activas, slaMap, ahora])

  const ordenPrioridad = useMemo(() => ['Baja', 'Media', 'Alta', 'Crítica'].filter((p) => slaPorPrioridad[p]), [slaPorPrioridad])
  const totalSla = useMemo(() => {
    let aTiempo = 0
    let alerta = 0
    let vencidas = 0
    const porSeries = { aTiempo: [] as number[], alerta: [] as number[], vencidas: [] as number[] }
    for (const p of ordenPrioridad) {
      const v = slaPorPrioridad[p]
      porSeries.aTiempo.push(v.aTiempo)
      porSeries.alerta.push(v.alerta)
      porSeries.vencidas.push(v.vencidas)
      aTiempo += v.aTiempo
      alerta += v.alerta
      vencidas += v.vencidas
    }
    return { aTiempo, alerta, vencidas, porSeries }
  }, [ordenPrioridad, slaPorPrioridad])

  const serieData = useMemo(() => ({
    labels: analisis?.series.map((s) => s.mes) ?? [],
    datasets: [
      { label: 'Recibidas', data: analisis?.series.map((s) => s.recibidas) ?? [], borderColor: c.info, backgroundColor: c.info, tension: 0.3, fill: false, pointRadius: 3, borderWidth: 2 },
      { label: 'Resueltas', data: analisis?.series.map((s) => s.resueltas) ?? [], borderColor: c.success, backgroundColor: c.success, tension: 0.3, fill: false, pointRadius: 3, borderWidth: 2 },
    ],
  }), [analisis?.series, c])
  const recibidasMes = analisis?.series.at(-1)?.recibidas
  const resueltasMes = analisis?.series.at(-1)?.resueltas

  const situacion = useMemo(() => {
    const grupos = new Map<string, number>()
    for (const e of analisis?.porEstado ?? []) {
      const clave = macroSituacion(e.etiqueta)
      grupos.set(clave, (grupos.get(clave) ?? 0) + e.total)
    }
    return [...grupos.entries()]
      .map(([etiqueta, total]) => ({ etiqueta, total }))
      .sort((a, b) => ORDEN_SITUACION.indexOf(a.etiqueta) - ORDEN_SITUACION.indexOf(b.etiqueta))
  }, [analisis?.porEstado])
  const estadoTotal = useMemo(() => situacion.reduce((sum, s) => sum + s.total, 0), [situacion])
  const colorSituacion = useMemo(() => ({
    'Recibidas': c.info,
    'En gestión': c.primary,
    'Pendientes de revisión': c.warning,
    'Cerradas/Resueltas': c.success,
    'No procede': c.secondary,
    'Otros': c.muted,
  } as Record<string, string>), [c])
  const donutData = useMemo(() => ({
    labels: situacion.map((s) => s.etiqueta),
    datasets: [{ data: situacion.map((s) => s.total), backgroundColor: situacion.map((s) => colorSituacion[s.etiqueta] ?? c.muted), borderWidth: 0 }],
  }), [situacion, colorSituacion, c])
  const situacionEsDonut = situacion.length > 0 && situacion.length <= 5
  const situacionBar = useMemo(() => ({
    labels: situacion.map((s) => s.etiqueta),
    datasets: [{ label: 'Quejas', data: situacion.map((s) => s.total), backgroundColor: situacion.map((s) => colorSituacion[s.etiqueta] ?? c.muted), borderRadius: 3, maxBarThickness: 16 }],
  }), [situacion, colorSituacion, c])

  const slaData = useMemo(() => ({
    labels: ordenPrioridad,
    datasets: [
      { label: 'A tiempo', data: totalSla.porSeries.aTiempo, backgroundColor: c.success, borderRadius: 2, maxBarThickness: 18 },
      { label: 'En alerta', data: totalSla.porSeries.alerta, backgroundColor: c.warning, borderRadius: 2, maxBarThickness: 18 },
      { label: 'Vencidas', data: totalSla.porSeries.vencidas, backgroundColor: c.danger, borderRadius: 2, maxBarThickness: 18 },
    ],
  }), [ordenPrioridad, totalSla, c])

  const catData = useMemo(() => ({
    labels: analisis?.porCategoria.map((cat) => cat.etiqueta) ?? [],
    datasets: [{ label: 'Quejas', data: analisis?.porCategoria.map((cat) => cat.total) ?? [], backgroundColor: c.primary, borderRadius: 3, maxBarThickness: 16 }],
  }), [analisis?.porCategoria, c])

  const calcularSLA = (fechaSla: string, prioridad: string, estado: string) => {
    if (estadoVariant[estado] === 'green') return { label: 'Completado', variant: 'green' }
    const dias = Math.max(0, Math.floor((new Date(fechaSla).getTime() - ahora) / 86400000))
    const sla = slaMap[prioridad]
    if (sla) {
      if (dias <= sla.dias_alerta) return { label: `${dias}d`, variant: 'green' }
      if (dias <= sla.dias_vencimiento) return { label: `${dias}d`, variant: 'amber' }
      return { label: `${dias}d`, variant: 'red' }
    }
    if (dias <= 3) return { label: `${dias}d`, variant: 'green' }
    if (dias <= 7) return { label: `${dias}d`, variant: 'amber' }
    return { label: `${dias}d`, variant: 'red' }
  }

  if (estadisticas.error) {
    return <ErrorState error={estadisticas.error} title="No se pudieron cargar los indicadores de quejas" onRetry={() => void estadisticas.refetch()} retrying={estadisticas.isFetching} />
  }
  if (error) {
    return <ErrorState error={error} title="No se pudieron cargar los datos del módulo de quejas" onRetry={() => void refetch()} retrying={isFetching} />
  }
  if (!estadisticas.data || (isPending && !analisis)) {
    return <div role="status" className={styles.empty}><CSpinner color="primary" /></div>
  }

  const d = estadisticas.data
  const noProceden = Math.max(0, d.totalConDecision - d.procedentes)
  const atencion = analisis?.atencion ?? []

  return (
    <div role="tabpanel">
      <CRow className="g-3 mb-4">
        <CCol xs={12} lg={8}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <h2 className="m-0 fs-5">Quejas recibidas vs resueltas</h2>
              <div className="d-flex gap-2 flex-wrap">
                <PanelMetric color="info" etiqueta="Recibidas este mes" valor={recibidasMes ?? d.mesActual} />
                <PanelMetric color="success" etiqueta="Resueltas este mes" valor={resueltasMes ?? 0} />
              </div>
            </CCardHeader>
            <CCardBody>
              {serieData.labels.length ? (
                <div className={styles.chartLarge}>
                  <CChart
                    type="line"
                    wrapper={false}
                    customTooltips={false}
                    role="img"
                    aria-label="Quejas recibidas y resueltas por mes"
                    data={serieData}
                    options={opcionesLinea(c) as never}
                  />
                </div>
              ) : (
                <ChartEmpty mensaje="No hay suficientes datos históricos para mostrar la evolución de quejas." />
              )}
            </CCardBody>
          </CCard>
        </CCol>
        <CCol xs={12} lg={4}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <h2 className="m-0 fs-5">Situación actual de las quejas</h2>
            </CCardHeader>
            <CCardBody>
              {situacion.length === 0 ? (
                <ChartEmpty mensaje="No hay quejas registradas." />
              ) : situacionEsDonut ? (
                <>
                  <div className={styles.donut}>
                    <CChart
                      type="doughnut"
                      wrapper={false}
                      customTooltips={false}
                      role="img"
                      aria-label={situacion.map((s) => `${s.etiqueta}: ${s.total}`).join(', ')}
                      data={donutData}
                      options={opcionesDonut() as never}
                    />
                    <div className={styles.donutTotal}><strong>{estadoTotal}</strong><span>Quejas</span></div>
                  </div>
                  <div className={styles.legend}>
                    {situacion.map((s) => (
                      <span key={s.etiqueta}><i style={{ background: colorSituacion[s.etiqueta] ?? c.muted }} />{s.etiqueta} <strong>{s.total}</strong></span>
                    ))}
                  </div>
                </>
              ) : (
                <div className={styles.chartMedium}>
                  <CChart
                    type="bar"
                    wrapper={false}
                    customTooltips={false}
                    role="img"
                    aria-label={situacion.map((s) => `${s.etiqueta}: ${s.total}`).join(', ')}
                    data={situacionBar}
                    options={opcionesBarras(c, { horizontal: true }) as never}
                  />
                </div>
              )}
              <p className="small text-body-secondary mt-3 mb-0">Total: <strong>{d.total.toLocaleString('es-CR')}</strong> quejas · Procedencia: <strong>{d.pctProcedencia}%</strong> ({d.totalConDecision} decididas · {noProceden} no proceden)</p>
            </CCardBody>
          </CCard>
        </CCol>
      </CRow>

      <CRow className="g-3 mb-4">
        <CCol xs={12} lg={6}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <h2 className="m-0 fs-5">Cumplimiento de SLA</h2>
              <div className="d-flex gap-2 flex-wrap">
                <PanelMetric color="success" etiqueta="A tiempo" valor={totalSla.aTiempo} />
                <PanelMetric color="warning" etiqueta="En alerta" valor={totalSla.alerta} />
                <PanelMetric color="danger" etiqueta="Vencidas" valor={totalSla.vencidas} />
              </div>
            </CCardHeader>
            <CCardBody>
              {ordenPrioridad.length === 0 ? (
                <ChartEmpty mensaje="No hay quejas abiertas con fecha SLA." />
              ) : (
                <div className={styles.chartMedium}>
                  <CChart
                    type="bar"
                    wrapper={false}
                    customTooltips={false}
                    role="img"
                    aria-label={`Cumplimiento SLA por prioridad · A tiempo ${totalSla.aTiempo}, en alerta ${totalSla.alerta}, vencidas ${totalSla.vencidas}`}
                    data={slaData}
                    options={opcionesBarras(c, { apilado: true, leyenda: true }) as never}
                  />
                </div>
              )}
            </CCardBody>
          </CCard>
        </CCol>
        <CCol xs={12} lg={6}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <h2 className="m-0 fs-5">Quejas por categoría</h2>
            </CCardHeader>
            <CCardBody>
              {catData.labels.length === 0 ? (
                <ChartEmpty mensaje="Sin quejas registradas en el período." />
              ) : (
                <div className={styles.chartMedium}>
                  <CChart
                    type="bar"
                    wrapper={false}
                    customTooltips={false}
                    role="img"
                    aria-label={(analisis?.porCategoria ?? []).map((cat) => `${cat.etiqueta}: ${cat.total}`).join(', ')}
                    data={catData}
                    options={opcionesBarras(c, { horizontal: true }) as never}
                  />
                </div>
              )}
            </CCardBody>
          </CCard>
        </CCol>
      </CRow>

      <CCard>
        <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <h2 className="m-0 fs-5">Quejas que requieren atención</h2>
          <Link href="/quejas" className="fw-medium text-decoration-none" style={{ fontSize: 14 }}>Ver todas las quejas</Link>
        </CCardHeader>
        <CCardBody className="p-0">
          <CTable hover responsive className="mb-0 align-middle">
            <CTableHead>
              <CTableRow>{['Folio', 'Cliente', 'Estado', 'SLA', 'Vencimiento'].map((label) => <CTableHeaderCell key={label} scope="col">{label}</CTableHeaderCell>)}</CTableRow>
            </CTableHead>
            <CTableBody>
              {atencion.length === 0 ? (
                <CTableRow><CTableDataCell colSpan={5}><div className={styles.emptyTable}>No hay quejas que requieran atención.</div></CTableDataCell></CTableRow>
              ) : atencion.map((q) => {
                const sla = calcularSLA(q.fecha_sla ?? q.fecha, q.prioridad || 'Media', q.estado)
                return (
                  <CTableRow key={q.id}>
                    <CTableDataCell><Link href="/quejas" className={styles.folio}>{q.folio}</Link></CTableDataCell>
                    <CTableDataCell>{q.cliente_nombre || '—'}</CTableDataCell>
                    <CTableDataCell><Badge variant={estadoVariant[q.estado] || 'gray'}>{q.estado}</Badge></CTableDataCell>
                    <CTableDataCell><Badge variant={sla.variant}>{sla.label}</Badge></CTableDataCell>
                    <CTableDataCell className="text-nowrap">{q.fecha_sla ? new Date(q.fecha_sla).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }) : 'Sin fecha'}</CTableDataCell>
                  </CTableRow>
                )
              })}
            </CTableBody>
          </CTable>
        </CCardBody>
      </CCard>
    </div>
  )
}
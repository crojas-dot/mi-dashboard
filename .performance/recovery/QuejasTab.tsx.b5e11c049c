'use client'

import { useMemo, useState } from 'react'
import Link from 'next/link'
import { CSpinner, CCard, CCardHeader, CCardBody } from '@coreui/react'
import CIcon from '@coreui/icons-react'
import { cilCheckCircle, cilThumbUp, cilCalendar, cilSpeedometer } from '@coreui/icons'
import ErrorState from '@/components/ui/ErrorState'
import Badge from '@/components/ui/Badge'
import StatCard from '@/components/StatCard'
import CChart from './Chart'
import { useSLAConfig, useQuejasEstadisticas, quejasEstadisticasKey } from '@/lib/queries/useQuejas'
import { useQuejasAnalisis, quejasAnalisisKey } from '@/lib/queries/useQuejasAnalisis'
import { useRealtimeSubscription } from '@/hooks/useRealtimeSubscription'
import { queryKeys } from '@/lib/queries/queryKeys'
import { estadoVariant } from '@/lib/constants/variants'
import styles from '@/app/dashboard.module.css'

const colorEstado: Record<string, string> = {
  Recibido: '#3399ff',
  'En Investigación': '#5856d6',
  'Pendiente de Revisión GC': '#f9b115',
  Resuelto: '#2eb85c',
  Finalizado: '#6b7785',
  'No Procede': '#adb5bd',
  Cerrada: '#2eb85c',
}

function chartCard(title: string, action: React.ReactNode | undefined, children: React.ReactNode) {
  return (
    <CCard className="h-100">
      <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 className="m-0 fs-5">{title}</h2>
        {action}
      </CCardHeader>
      <CCardBody>{children}</CCardBody>
    </CCard>
  )
}

export default function QuejasTab() {
  const estadisticas = useQuejasEstadisticas()
  const slaConfig = useSLAConfig('quejas')
  const { data: analisis, isPending, isFetching, error, refetch } = useQuejasAnalisis()
  const [ahora] = useState(() => Date.now())

  useRealtimeSubscription({
    table: 'quejas',
    invalidateKeys: [quejasEstadisticasKey, quejasAnalisisKey, [...queryKeys.dashboard]],
  })

  const slaMap = useMemo(() => {
    const m: Record<string, { dias_alerta: number; dias_vencimiento: number }> = {}
    for (const s of slaConfig.data ?? []) m[s.prioridad] = s
    return m
  }, [slaConfig.data])

  const slaPorPrioridad = useMemo(() => {
    const res: Record<string, { aTiempo: number; alerta: number; vencidas: number }> = {}
    for (const f of analisis?.activas ?? []) {
      if (!f.fecha_sla) continue
      const p = f.prioridad || 'Media'
      const cfg = slaMap[p] ?? { dias_alerta: 3, dias_vencimiento: 7 }
      const dias = Math.floor((ahora - new Date(f.fecha_sla).getTime()) / 86400000)
      const row = res[p] ?? (res[p] = { aTiempo: 0, alerta: 0, vencidas: 0 })
      if (dias <= cfg.dias_alerta) row.aTiempo += 1
      else if (dias <= cfg.dias_vencimiento) row.alerta += 1
      else row.vencidas += 1
    }
    return res
  }, [analisis?.activas, slaMap, ahora])

  const totalSla = useMemo(() => {
    let aTiempo = 0
    let alerta = 0
    let vencidas = 0
    for (const r of Object.values(slaPorPrioridad)) {
      aTiempo += r.aTiempo
      alerta += r.alerta
      vencidas += r.vencidas
    }
    return { aTiempo, alerta, vencidas }
  }, [slaPorPrioridad])

  const serieData = useMemo(() => ({
    labels: analisis?.series.map((s) => s.mes) ?? [],
    datasets: [
      { label: 'Recibidas', data: analisis?.series.map((s) => s.recibidas) ?? [], borderColor: '#3399ff', backgroundColor: '#3399ff', tension: 0.3, fill: false, pointRadius: 3, borderWidth: 2 },
      { label: 'Resueltas', data: analisis?.series.map((s) => s.resueltas) ?? [], borderColor: '#2eb85c', backgroundColor: '#2eb85c', tension: 0.3, fill: false, pointRadius: 3, borderWidth: 2 },
    ],
  }), [analisis?.series])

  const serieOptions = useMemo(() => ({
    maintainAspectRatio: false,
    animation: false,
    plugins: { legend: { display: true, position: 'bottom' as const, labels: { boxWidth: 12, font: { size: 13 } } } },
    scales: {
      x: { grid: { display: false }, ticks: { color: '#626975', font: { size: 12 } } },
      y: { beginAtZero: true, ticks: { precision: 0, color: '#626975', font: { size: 13 } }, grid: { color: '#e7e9ee' } },
    },
  }), [])

  const estadoTotal = useMemo(() => (analisis?.porEstado ?? []).reduce((sum, e) => sum + e.total, 0), [analisis?.porEstado])
  const donutData = useMemo(() => ({
    labels: analisis?.porEstado.map((e) => e.etiqueta) ?? [],
    datasets: [{ data: analisis?.porEstado.map((e) => e.total) ?? [], backgroundColor: (analisis?.porEstado ?? []).map((e) => colorEstado[e.etiqueta] ?? '#adb5bd'), borderWidth: 0 }],
  }), [analisis?.porEstado])
  const donutOptions = useMemo(() => ({
    maintainAspectRatio: false,
    animation: false,
    cutout: '70%',
    plugins: { legend: { display: false }, tooltip: { enabled: estadoTotal > 0 } },
  }), [estadoTotal])

  const catData = useMemo(() => ({
    labels: analisis?.porCategoria.map((c) => c.etiqueta) ?? [],
    datasets: [{ label: 'Quejas', data: analisis?.porCategoria.map((c) => c.total) ?? [], backgroundColor: '#5856d6', borderRadius: 3, maxBarThickness: 16 }],
  }), [analisis?.porCategoria])
  const catOptions = useMemo(() => ({
    indexAxis: 'y' as const,
    maintainAspectRatio: false,
    animation: false,
    plugins: { legend: { display: false }, tooltip: { titleFont: { size: 14 }, bodyFont: { size: 13 } } },
    scales: {
      x: { beginAtZero: true, ticks: { precision: 0, color: '#626975', font: { size: 13 } }, grid: { color: '#e7e9ee' } },
      y: { grid: { display: false }, ticks: { color: '#626975', font: { size: 13 } } },
    },
  }), [])

  const calcularSLA = (fechaSla: string, prioridad: string, estado: string) => {
    if (estadoVariant[estado] === 'green') return { label: 'Completado', variant: 'green' }
    const dias = Math.max(0, Math.floor((new Date(fechaSla).getTime() - ahora) / 86400000))
    const sla = slaMap[prioridad]
    if (sla) {
      if (dias <= sla.dias_alerta) return { label: `${dias}d`, variant: 'green' }
      if (dias <= sla.dias_vencimiento) return { label: `${dias}d`, variant: 'amber' }
      return { label: `${dias}d`, variant: 'red' }
    }
    if (dias <= 3) return { label: `${dias}d`, variant: 'green' }
    if (dias <= 7) return { label: `${dias}d`, variant: 'amber' }
    return { label: `${dias}d`, variant: 'red' }
  }

  if (estadisticas.error) {
    return <ErrorState error={estadisticas.error} title="No se pudieron cargar los indicadores de quejas" onRetry={() => void estadisticas.refetch()} retrying={estadisticas.isFetching} />
  }
  if (error) {
    return <ErrorState error={error} title="No se pudieron cargar los datos del módulo de quejas" onRetry={() => void refetch()} retrying={isFetching} />
  }
  if (!estadisticas.data || (isPending && !analisis)) {
    return <div role="status" className={styles.empty}><CSpinner color="primary" /></div>
  }

  const d = estadisticas.data
  const noProceden = Math.max(0, d.totalConDecision - d.procedentes)
  const atencion = analisis?.atencion ?? []

  const kpis = [
    { title: 'Resueltas a tiempo', value: `${d.pctATiempo}%`, color: 'green' as const, icon: <CIcon icon={cilCheckCircle} height={28} />, subtitle: `${d.resueltasTotal} resueltas/finalizadas evaluadas según su fecha SLA` },
    { title: 'Procedencia', value: `${d.pctProcedencia}%`, color: 'blue' as const, icon: <CIcon icon={cilThumbUp} height={28} />, subtitle: `${d.totalConDecision} decididas · ${noProceden} no proceden` },
    { title: 'Quejas este mes', value: d.mesActual, color: 'purple' as const, icon: <CIcon icon={cilCalendar} height={28} />, subtitle: new Date(ahora).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' }) },
    { title: 'Total quejas', value: d.total, color: 'red' as const, icon: <CIcon icon={cilSpeedometer} height={28} />, subtitle: 'Registros del módulo' },
  ]

  return (
    <div role="tabpanel">
      <div className={styles.sectionHeading}>
        <h2>Rendimiento de Quejas</h2>
        <p>Indicadores de desempeño y seguimiento del módulo de Quejas</p>
      </div>

      <div className={styles.kpiGrid}>
        {kpis.map((k) => (
          <StatCard key={k.title} title={k.title} value={k.value} icon={k.icon} color={k.color} subtitle={k.subtitle} />
        ))}
      </div>

      <div className={styles.chartsRowEven}>
        {chartCard('Quejas recibidas vs resueltas', undefined,
          <div className={styles.chartLarge}>
            <CChart
              type="line"
              wrapper={false}
              customTooltips={false}
              role="img"
              aria-label="Quejas recibidas y resueltas por mes"
              data={serieData}
              options={serieOptions as never}
            />
          </div>
        )}
        {chartCard('Estado de las quejas', undefined,
          <>
            <div className={styles.donut}>
              <CChart
                type="doughnut"
                wrapper={false}
                customTooltips={false}
                role="img"
                aria-label={(analisis?.porEstado ?? []).map((e) => `${e.etiqueta}: ${e.total}`).join(', ')}
                data={donutData}
                options={donutOptions as never}
              />
              <div className={styles.donutTotal}><strong>{estadoTotal}</strong><span>Quejas</span></div>
            </div>
            <div className={styles.estadoLegend}>
              {(analisis?.porEstado ?? []).map((e) => (
                <span key={e.etiqueta}><i style={{ background: colorEstado[e.etiqueta] ?? '#adb5bd' }} />{e.etiqueta} <strong>{e.total}</strong></span>
              ))}
            </div>
          </>
        )}
      </div>

      <div className={styles.chartsRowEven}>
        {chartCard('Cumplimiento SLA', undefined,
          Object.keys(slaPorPrioridad).length === 0 ? (
            <p className="text-body-secondary mb-0">No hay quejas abiertas con fecha SLA.</p>
          ) : (
            <>
              {Object.entries(slaPorPrioridad).map(([p, v]) => {
                const total = v.aTiempo + v.alerta + v.vencidas
                return (
                  <div key={p} className={styles.slaRow}>
                    <span className={styles.slaName}>{p}</span>
                    <div className={styles.slaStack}>
                      {total > 0 && v.aTiempo > 0 && <span style={{ width: `${(v.aTiempo / total) * 100}%`, background: '#2eb85c' }} />}
                      {total > 0 && v.alerta > 0 && <span style={{ width: `${(v.alerta / total) * 100}%`, background: '#f9b115' }} />}
                      {total > 0 && v.vencidas > 0 && <span style={{ width: `${(v.vencidas / total) * 100}%`, background: '#e55353' }} />}
                    </div>
                    <span className={styles.slaTotal}>{total}</span>
                  </div>
                )
              })}
              <div className={styles.slaLegend}>
                <span><i style={{ background: '#2eb85c' }} />A tiempo {totalSla.aTiempo}</span>
                <span><i style={{ background: '#f9b115' }} />En alerta {totalSla.alerta}</span>
                <span><i style={{ background: '#e55353' }} />Vencidas {totalSla.vencidas}</span>
              </div>
            </>
          )
        )}
        {chartCard('Quejas por categoría', undefined,
          catData.labels.length === 0 ? (
            <p className="text-body-secondary mb-0">Sin quejas registradas en el período.</p>
          ) : (
            <div className={styles.chartMedium}>
              <CChart
                type="bar"
                wrapper={false}
                customTooltips={false}
                role="img"
                aria-label={(analisis?.porCategoria ?? []).map((c) => `${c.etiqueta}: ${c.total}`).join(', ')}
                data={catData}
                options={catOptions as never}
              />
            </div>
          )
        )}
      </div>

      <CCard>
        <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <h2 className="m-0 fs-5">Quejas que requieren atención</h2>
        </CCardHeader>
        <CCardBody className="p-0">
          <div className={styles.tableWrap}>
            <table className="coreui-record-table w-full select-text">
              <thead><tr>{['Folio', 'Cliente', 'Estado', 'SLA', 'Vencimiento'].map((label) => <th key={label} scope="col">{label}</th>)}</tr></thead>
              <tbody>
                {atencion.length === 0 ? (
                  <tr><td colSpan={5}><div className={styles.empty}>No hay quejas que requieran atención</div></td></tr>
                ) : atencion.map((q) => {
                  const sla = calcularSLA(q.fecha_sla ?? q.fecha, q.prioridad || 'Media', q.estado)
                  return (
                    <tr key={q.id}>
                      <td><Link href="/quejas" className={styles.folio}>{q.folio}</Link></td>
                      <td>{q.cliente_nombre || '—'}</td>
                      <td><Badge variant={estadoVariant[q.estado] || 'gray'}>{q.estado}</Badge></td>
                      <td><Badge variant={sla.variant}>{sla.label}</Badge></td>
                      <td className="text-nowrap">{q.fecha_sla ? new Date(q.fecha_sla).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }) : 'Sin fecha'}</td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        </CCardBody>
      </CCard>
    </div>
  )
}
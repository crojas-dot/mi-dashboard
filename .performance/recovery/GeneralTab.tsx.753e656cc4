'use client'

import { useMemo, useState } from 'react'
import Link from 'next/link'
import {
  CSpinner,
  CRow,
  CCol,
  CCard,
  CCardHeader,
  CCardBody,
  CTable,
  CTableHead,
  CTableHeaderCell,
  CTableBody,
  CTableRow,
  CTableDataCell,
} from '@coreui/react'
import ErrorState from '@/components/ui/ErrorState'
import Badge from '@/components/ui/Badge'
import { History } from '@/components/ui/icons'
import { prioridadVariant } from '@/lib/constants/variants'
import { useActividadReciente, type DashboardData } from '@/lib/queries/useDashboard'
import { useQuejasAnalisis } from '@/lib/queries/useQuejasAnalisis'
import CChart from './Chart'
import { ChartEmpty, PanelMetric, opcionesBarras, opcionesDonut, opcionesLinea, uiColors } from './chartKit'
import styles from '@/app/dashboard.module.css'

interface GeneralTabProps {
  data?: DashboardData
  isPending: boolean
  isFetching: boolean
  error: Error | null
  refetch: () => void
}

const estadoBadge: Record<string, string> = {
  Abierta: 'red', Alta: 'red', 'En Proceso': 'amber', Planificada: 'blue',
  Abierto: 'red', Pendiente: 'amber', Cerrada: 'green', Cerrado: 'green',
  Publicado: 'green', Borrador: 'gray', Activo: 'green', Inactivo: 'gray',
}

export default function GeneralTab({ data, isPending, isFetching, error, refetch }: GeneralTabProps) {
  const actividad = useActividadReciente()
  const evolucion = useQuejasAnalisis()
  const [ahora] = useState(() => Date.now())
  const c = uiColors()

  const tareas = useMemo(() => data?.tareas ?? [], [data?.tareas])
  const distribucion = useMemo(() => [
    { label: 'Quejas', valor: data?.indicadores[0]?.valor ?? 0, color: c.info },
    { label: 'SACP', valor: data?.indicadores[1]?.valor ?? 0, color: c.warning },
    { label: 'Documentos', valor: data?.indicadores[2]?.valor ?? 0, color: c.secondary },
    { label: 'Riesgos', valor: data?.indicadores[3]?.valor ?? 0, color: c.primary },
  ], [data?.indicadores, c])
  const grupos = distribucion.filter((g) => g.valor > 0)
  const totalPendientes = distribucion.reduce((sum, g) => sum + g.valor, 0)

  const vencimientos = useMemo(() => {
    const b = { '≤ 7 días': 0, '8–15 días': 0, '16–30 días': 0, 'Más de 30 días': 0 }
    for (const t of tareas) {
      if (!t.vence) continue
      const dias = Math.floor((new Date(t.vence).getTime() - ahora) / 86400000)
      if (dias <= 7) b['≤ 7 días'] += 1
      else if (dias <= 15) b['8–15 días'] += 1
      else if (dias <= 30) b['16–30 días'] += 1
      else b['Más de 30 días'] += 1
    }
    return b
  }, [tareas, ahora])
  const hayVencimientos = tareas.some((t) => t.vence)

  const coloresVencidos = useMemo(() => [c.danger, c.warning, c.info, c.secondary], [c])
  const venceData = useMemo(() => ({
    labels: Object.keys(vencimientos),
    datasets: [{
      label: 'Expedientes',
      data: Object.values(vencimientos),
      backgroundColor: coloresVencidos,
      borderRadius: 3,
      maxBarThickness: 16,
    }],
  }), [vencimientos, coloresVencidos])

  const donutData = useMemo(() => ({
    labels: grupos.map((g) => g.label),
    datasets: [{
      data: grupos.map((g) => g.valor),
      backgroundColor: grupos.map((g) => g.color),
      borderWidth: 0,
    }],
  }), [grupos])

  const serieData = useMemo(() => ({
    labels: evolucion.data?.series.map((s) => s.mes) ?? [],
    datasets: [
      { label: 'Recibidas', data: evolucion.data?.series.map((s) => s.recibidas) ?? [], borderColor: c.info, backgroundColor: c.info, tension: 0.3, fill: false, pointRadius: 3, borderWidth: 2 },
      { label: 'Resueltas', data: evolucion.data?.series.map((s) => s.resueltas) ?? [], borderColor: c.success, backgroundColor: c.success, tension: 0.3, fill: false, pointRadius: 3, borderWidth: 2 },
    ],
  }), [evolucion.data?.series, c])
  const serieReciente = evolucion.data?.series.at(-1)
  const seriePrevio = evolucion.data?.series.at(-2)

  if (error) {
    return <ErrorState error={error} title="No se pudo cargar el panel general" onRetry={() => void refetch()} retrying={isFetching} />
  }
  if (isPending || !data) {
    return <div role="status" className={styles.empty}><CSpinner color="primary" /></div>
  }

  return (
    <div role="tabpanel">
      <CRow className="g-3 mb-4">
        <CCol xs={12} lg={8}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <h2 className="m-0 fs-5">Vencimientos próximos</h2>
              <Link href="/quejas" className="fw-medium text-decoration-none" style={{ fontSize: 14 }}>Ver quejas</Link>
            </CCardHeader>
            <CCardBody>
              {hayVencimientos ? (
                <>
                  <div className={styles.chartMedium}>
                    <CChart
                      type="bar"
                      wrapper={false}
                      customTooltips={false}
                      role="img"
                      aria-label={Object.entries(vencimientos).map(([k, v]) => `${k}: ${v}`).join(', ')}
                      data={venceData}
                      options={opcionesBarras(c, { horizontal: true }) as never}
                    />
                  </div>
                  <div className={styles.legend}>
                    {Object.entries(vencimientos).map(([k, v]) => (
                      <span key={k}><i style={{ background: coloresVencidos[Object.keys(vencimientos).indexOf(k)] }} />{k} <strong>{v}</strong></span>
                    ))}
                  </div>
                </>
              ) : (
                <ChartEmpty mensaje="No hay expedientes con vencimiento próximo." />
              )}
            </CCardBody>
          </CCard>
        </CCol>
        <CCol xs={12} lg={4}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center gap-2">
              <h2 className="m-0 fs-5">Distribución de pendientes</h2>
            </CCardHeader>
            <CCardBody>
              {grupos.length ? (
                <>
                  <div className={styles.donut}>
                    <CChart
                      type="doughnut"
                      wrapper={false}
                      customTooltips={false}
                      role="img"
                      aria-label={grupos.map((g) => `${g.label}: ${g.valor}`).join(', ')}
                      data={donutData}
                      options={opcionesDonut() as never}
                    />
                    <div className={styles.donutTotal}><strong>{totalPendientes}</strong><span>Pendientes</span></div>
                  </div>
                  <div className={styles.legend}>
                    {grupos.map((g) => (
                      <span key={g.label}><i style={{ background: g.color }} />{g.label} <strong>{g.valor}</strong></span>
                    ))}
                  </div>
                </>
              ) : (
                <ChartEmpty mensaje="No hay pendientes registrados." />
              )}
            </CCardBody>
          </CCard>
        </CCol>
      </CRow>

      <CCard className="mb-4">
        <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <h2 className="m-0 fs-5">Evolución de la gestión</h2>
          <div className="d-flex gap-3 flex-wrap">
            {serieReciente && (
              <PanelMetric color="info" etiqueta={`Recibidas ${serieReciente.mes}`} valor={serieReciente.recibidas} />
            )}
            {serieReciente && (
              <PanelMetric color="success" etiqueta={`Resueltas ${serieReciente.mes}`} valor={serieReciente.resueltas} />
            )}
            {seriePrevio && (
              <PanelMetric color="secondary" etiqueta={`Diferencia entradas (${seriePrevio.mes} → ${serieReciente?.mes})`} valor={diferenciaConSigno(seriePrevio.recibidas - (serieReciente?.recibidas ?? 0))} />
            )}
          </div>
        </CCardHeader>
        <CCardBody>
          {evolucion.isPending ? (
            <div role="status" className={styles.empty}><CSpinner color="primary" /></div>
          ) : serieData.labels.length ? (
            <div className={styles.chartLarge}>
              <CChart
                type="line"
                wrapper={false}
                customTooltips={false}
                role="img"
                aria-label="Evolución mensual de quejas recibidas y resueltas"
                data={serieData}
                options={opcionesLinea(c) as never}
              />
            </div>
          ) : (
            <ChartEmpty mensaje="No hay suficientes datos históricos para mostrar la evolución." />
          )}
        </CCardBody>
      </CCard>

      <CRow className="g-3">
        <CCol xs={12} lg={8}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <h2 className="m-0 fs-5">Expedientes que requieren atención</h2>
            </CCardHeader>
            <CCardBody className="p-0">
              <CTable hover responsive className="mb-0 align-middle">
                <CTableHead>
                  <CTableRow>{['Expediente', 'Tipo', 'Estado', 'Vencimiento', 'Prioridad'].map((label) => <CTableHeaderCell key={label} scope="col">{label}</CTableHeaderCell>)}</CTableRow>
                </CTableHead>
                <CTableBody>
                  {tareas.length === 0 ? (
                    <CTableRow><CTableDataCell colSpan={5}><div className={styles.emptyTable}>No hay expedientes pendientes.</div></CTableDataCell></CTableRow>
                  ) : tareas.map((t) => (
                    <CTableRow key={`${t.entidad}-${t.id}`}>
                      <CTableDataCell><strong className="fw-medium">{t.titulo}</strong><div className="small text-body-secondary">{t.entidad}</div></CTableDataCell>
                      <CTableDataCell>{t.tipo}</CTableDataCell>
                      <CTableDataCell><Badge variant={estadoBadge[t.estado] ?? 'gray'}>{t.estado}</Badge></CTableDataCell>
                      <CTableDataCell className="text-nowrap">{t.vence ? new Date(t.vence).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' }) : 'Sin fecha'}</CTableDataCell>
                      <CTableDataCell>{t.prioridad ? <Badge variant={prioridadVariant[t.prioridad] ?? 'gray'}>{t.prioridad}</Badge> : '—'}</CTableDataCell>
                    </CTableRow>
                  ))}
                </CTableBody>
              </CTable>
            </CCardBody>
          </CCard>
        </CCol>
        <CCol xs={12} lg={4}>
          <CCard className="h-100">
            <CCardHeader className="d-flex align-items-center gap-2">
              <h2 className="m-0 fs-5">Actividad reciente</h2>
              <History size={18} />
            </CCardHeader>
            <CCardBody>
              {actividad.isPending ? <div className="d-flex justify-content-center py-2" role="status"><CSpinner size="sm" /></div>
                : actividad.error ? <ErrorState error={actividad.error} title="No se pudo cargar la actividad" onRetry={() => void actividad.refetch()} retrying={actividad.isFetching} />
                  : !actividad.data?.length ? <p className="text-body-secondary mb-0">Sin actividad registrada.</p>
                    : <ol className={styles.timeline}>{actividad.data.map((item) => <li key={item.id}><p>{item.descripcion}</p><time dateTime={item.created_at}>{new Date(item.created_at).toLocaleString('es-CR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</time></li>)}</ol>}
            </CCardBody>
          </CCard>
        </CCol>
      </CRow>
    </div>
  )
}

function diferenciaConSigno(n: number): string {
  return `${n >= 0 ? '+' : ''}${n}`
}